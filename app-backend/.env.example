PORT=5000
NODE_ENV=development

# Database configuration. If DATABASE_URL is provided, Sequelize will use PostgreSQL.
# Otherwise, it falls back to a local SQLite database file: './db.sqlite'
# DATABASE_URL=postgres://user:password@localhost:5432/artifact_db

# standalone Agent System endpoint and token for authorization
AGENT_SYSTEM_API_URL=http://localhost:8080/v1
AGENT_SYSTEM_BEARER_TOKEN=some-secure-agent-token-if-set
