PORT=5000
NODE_ENV=development

# Persistence: Firestore (Native mode) — fully serverless, scales to zero.
# On Cloud Run it uses Application Default Credentials; set the project explicitly:
GCP_PROJECT_ID=your-gcp-project-id
# For local development, run the Firestore emulator and point the client at it:
# FIRESTORE_EMULATOR_HOST=localhost:8085

# standalone Agent System endpoint and token for authorization
AGENT_SYSTEM_API_URL=http://localhost:8080/v1
AGENT_SYSTEM_BEARER_TOKEN=some-secure-agent-token-if-set

# CORS: allowed frontend origin(s), comma-separated. Use "*" only in local dev.
APP_CORS_ORIGIN=http://localhost:3000

# Authentication: shared password -> backend-issued JWT. Both must be set to
# enable auth (leave unset in local dev to disable). Keep these server-side only.
APP_ACCESS_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-a-long-random-string
