PORT=5000
NODE_ENV=development

# Persistence: Firestore (Native mode) — fully serverless, scales to zero.
# On Cloud Run it uses Application Default Credentials; set the project explicitly:
GCP_PROJECT_ID=your-gcp-project-id
# For local development, run the Firestore emulator and point the client at it:
# FIRESTORE_EMULATOR_HOST=localhost:8085

# standalone Agent System endpoint and token for authorization
AGENT_SYSTEM_API_URL=http://localhost:8080/v1
AGENT_SYSTEM_BEARER_TOKEN=some-secure-agent-token-if-set

# CORS: allowed frontend origin(s), comma-separated. Use "*" only in local dev.
APP_CORS_ORIGIN=http://localhost:3000

# Authentication: shared password -> backend-issued JWT. Both must be set to
# enable auth (leave unset in local dev to disable). Keep these server-side only.
APP_ACCESS_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Kafka / Confluent Cloud — prop lifecycle event backbone (OPTIONAL, off by default)
# ---------------------------------------------------------------------------
# Master feature flag. When false/unset the consumer is a complete no-op and the
# kafkajs client is never loaded (the package is not required at runtime).
KAFKA_ENABLED=false
# Comma-separated bootstrap servers, e.g. pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=
# Confluent Cloud API key / secret (used as SASL username / password).
KAFKA_API_KEY=
KAFKA_API_SECRET=
# Topic carrying PropEvent messages (must match the producer / agent-system).
KAFKA_TOPIC=artifact.prop.events
# Security + SASL settings for Confluent Cloud.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
# Consumer group id for this backend (each backend instance shares the group).
KAFKA_CONSUMER_GROUP_ID=artifact-backend-prop-events
