PORT=5000
NODE_ENV=development

# Database configuration. If DATABASE_URL is provided, Sequelize will use PostgreSQL.
# Otherwise, it falls back to a local SQLite database file: './db.sqlite'
# DATABASE_URL=postgres://user:password@localhost:5432/artifact_db

# Cloud SQL (Postgres) on GCP via the Cloud Run unix socket. Set these instead of
# DATABASE_URL when deploying with --add-cloudsql-instances:
# INSTANCE_CONNECTION_NAME=project:region:instance
# PGDATABASE=artifact
# PGUSER=postgres
# PGPASSWORD=change-me

# standalone Agent System endpoint and token for authorization
AGENT_SYSTEM_API_URL=http://localhost:8080/v1
AGENT_SYSTEM_BEARER_TOKEN=some-secure-agent-token-if-set

# CORS: allowed frontend origin(s), comma-separated. Use "*" only in local dev.
APP_CORS_ORIGIN=http://localhost:3000

# Optional bearer token to require on this backend's /api routes (leave unset in dev).
APP_API_TOKEN=
